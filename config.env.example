# Copie para config.env quando tiver contas realmente configuradas SEM faturamento.
# Nunca publique config.env, nem compartilhe suas chaves.
# O programa nao ativa servicos pagos nem compra creditos.
# CONFIRME FORA DO PROGRAMA que seus projetos estao no plano gratuito.
FREE_TIER_CONFIRMED=NO
FREE_PROVIDER_ORDER=gemini,groq,openrouter
MAX_REQUESTS_PER_RUN=12
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
